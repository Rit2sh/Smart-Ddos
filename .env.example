# Smart DDoS Shield - Environment Variables Example
# Duplicate this file to .env and configure with appropriate values.

# Server & App Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_ddos_shield?schema=public"

# Authentication & Cryptography
# Generate a secure 32+ character key for JWT signing, e.g.: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
SESSION_COOKIE_NAME="smart_ddos_session"

# Google OAuth 2.0 / OIDC (Optional in local dev, required for Google sign-in)
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Redirect URI: http://localhost:3000/api/auth/oauth/callback?provider=google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth App (Optional in local dev, required for GitHub sign-in)
# Obtain from GitHub Settings > Developer Settings > OAuth Apps
# Callback URL: http://localhost:3000/api/auth/oauth/callback?provider=github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Redis Cache & Ingestion Queue (Optional for local dev)
REDIS_URL="redis://localhost:6379"

# Telemetry Collector Ingestion Secret
COLLECTOR_INGESTION_SECRET="replace-with-collector-shared-secret"

# Verification DNS / HTTP Challenge Domain Name
VERIFICATION_HOST_DOMAIN="verify.smartddos.io"

# Logging & Telemetry
LOG_LEVEL="info"
DEMO_MODE="true"
